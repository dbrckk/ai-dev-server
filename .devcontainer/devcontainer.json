{
  "name": "AI Dev Server",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:1-22-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/python:1": {
      "version": "3.12"
    },
    "ghcr.io/devcontainers/features/github-cli:1": {},
    "ghcr.io/devcontainers/features/sshd:1": {
      "version": "latest"
    }
  },
  "postCreateCommand": "bash scripts/bootstrap.sh",
  "postStartCommand": "bash scripts/start-all.sh",
  "forwardPorts": [8082, 3080, 3000],
  "portsAttributes": {
    "8082": { "label": "Free Claude Code Admin/API", "onAutoForward": "notify", "visibility": "private" },
    "3080": { "label": "DeepSeek Harness", "onAutoForward": "openBrowser", "visibility": "private" },
    "3000": { "label": "cdesktop", "onAutoForward": "notify", "visibility": "private" }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "eamodio.gitlens"
      ],
      "settings": {
        "terminal.integrated.defaultProfile.linux": "bash"
      }
    }
  },
  "remoteUser": "node"
}
